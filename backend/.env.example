# ── App ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=info

# ── MongoDB ───────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/nexusai?retryWrites=true&w=majority

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_min32chars_required
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min32chars_required
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=https://your-frontend-app.onrender.com
